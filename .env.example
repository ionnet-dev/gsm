# Copy to .env for local development. All values have sane dev defaults except SESSION_SECRET.
PORT=3000
SITE_URL=http://localhost:5173
LOG_LEVEL=debug
# Log every SQL statement (very noisy).
LOG_SQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gsm
DB_USER=gsm
DB_PASSWORD=gsm
# Run pending migrations at startup (recommended for single-node deployments).
AUTO_MIGRATE=true
# 32+ random characters. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me
# Where the built web app lives; served by the server when present (production).
WEB_DIST=../web/dist
# Where uploaded agent binaries are stored.
DATA_DIR=./data
# Use the last X-Forwarded-For hop (added by your reverse proxy) as the client IP. Set false when
# clients connect directly, otherwise the header is attacker-controlled.
TRUST_PROXY=true

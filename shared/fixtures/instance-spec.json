{
  "uuid": "6f1c2a1e-9b7d-4c1a-8a0e-3d2b1c0f9e8d",
  "name": "Survival",
  "image": "ghcr.io/ionnet-dev/gsm-java:21",
  "startup": "java -Xms256M -Xmx3072M -jar server.jar nogui",
  "env": {
    "MC_VERSION": "1.21.1",
    "GSM_MEMORY_MB": "4096",
    "GSM_HEAP_MB": "3072",
    "GSM_PORT_GAME": "30000",
    "GSM_BIND": "0.0.0.0",
    "GSM_INSTANCE_UUID": "6f1c2a1e-9b7d-4c1a-8a0e-3d2b1c0f9e8d",
    "GSM_INSTANCE_NAME": "Survival"
  },
  "ports": [{ "name": "game", "protocol": "tcp", "host": 30000, "container": 30000 }],
  "bindAddress": "0.0.0.0",
  "limits": { "memoryMb": 4096, "cpuCores": 0, "diskMb": 0 },
  "stop": { "command": "stop", "signal": "SIGTERM", "timeoutSeconds": 60 },
  "console": { "readyPattern": "Done \\([0-9.]+s\\)!" },
  "files": [
    {
      "path": "server.properties",
      "format": "properties",
      "values": { "server-port": "30000", "query.port": "30000", "server-ip": "" }
    }
  ],
  "restartOnCrash": true,
  "user": { "uid": 1500, "gid": 1500 }
}
